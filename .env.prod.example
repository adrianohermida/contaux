# .env.prod — Variáveis de ambiente de produção
# Copie para .env.prod e preencha com valores reais
# NUNCA commite .env.prod no git

# Email (SMTP fallback — usado quando Cloudflare Worker falha)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contato@contaux.com.br
SMTP_PASS=sua-senha-de-app-aqui

# Email de destino do formulário de contato
CONTACT_EMAIL=contato@contaux.com.br
FROM_EMAIL=contato@contaux.com.br

# Cloudflare (Email Routing + Workers)
CLOUDFLARE_API_TOKEN=seu-token-aqui
CLOUDFLARE_ACCOUNT_ID=sua-account-id
CLOUDFLARE_ZONE_ID=sua-zone-id
CLOUDFLARE_API_TOKEN_ROUTING_MAIL=seu-token-routing-aqui
