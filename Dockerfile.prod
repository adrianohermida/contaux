# Dockerfile.prod — Build de produção Contaux
# Multi-stage: compila o dashboard React + serve tudo via nginx

# Stage 1: Compila o dashboard React para arquivos estáticos
FROM node:22-alpine AS dashboard-build
WORKDIR /app
COPY dashboard/package.json dashboard/package-lock.json ./
RUN npm ci
COPY dashboard/ .
RUN npm run build

# Stage 2: nginx serve site estático + dashboard compilado
FROM nginx:alpine
# Site estático (HTML/CSS/JS)
COPY . /usr/share/nginx/html
# Remove arquivos que não devem ir para produção
RUN rm -rf /usr/share/nginx/html/legacy /usr/share/nginx/html/docs /usr/share/nginx/html/.git
# Dashboard compilado
COPY --from=dashboard-build /app/dist /usr/share/nginx/dashboard
# Configuração nginx
COPY nginx/prod.conf /etc/nginx/conf.d/default.conf
COPY nginx/prod-routes.conf /etc/nginx/prod-routes.conf
